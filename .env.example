# Any Postgres works. Neon (free) or local: docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajaia_docs"
# Direct (non-pooled) URL used by `prisma db push`. Same as DATABASE_URL for local Postgres.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/ajaia_docs"
# Signs the mock-auth session cookie. Any long random string.
AUTH_SECRET="change-me-to-a-long-random-string"
